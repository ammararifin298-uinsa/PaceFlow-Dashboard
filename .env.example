# Salin file ini menjadi .env dan isi sesuai konfigurasi Anda
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)

# ── PostgreSQL (opsional — jika tidak diisi, otomatis pakai Demo Mode) ──────
PG_HOST=localhost
PG_PORT=5432
PG_DB=f1_analytics
PG_USER=postgres
PG_PASSWORD=your_password_here

# ── Mode Aplikasi ────────────────────────────────────────────────────────────
# true  = pakai demo_cache.csv (tanpa PostgreSQL)
# false = pakai PostgreSQL (wajib isi PG_* di atas)
F1_DEMO_MODE=true

# ── Data Directory ───────────────────────────────────────────────────────────
F1_DATA_DIR=./Data
